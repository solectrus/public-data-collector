##### General

# Country code, for example DE, AT or NL. The renewable share, the gas price
# and the fuel prices use it.
COUNTRY=DE

# Seconds between two cycles, minimum 60. This governs the electricity
# values. The gas price and the fuel prices are read on Friday and at every
# start.
INTERVAL=3600

# Timezone
TZ=Europe/Berlin

##### Sources

# Every source is off by default, and at least one must be on. Switch on
# only the sources whose values SOLECTRUS uses.
ENABLE_FUEL=true
ENABLE_GAS=false
ENABLE_PUBLIC_GRID=false

##### InfluxDB

INFLUX_HOST=localhost
INFLUX_SCHEMA=http
INFLUX_PORT=8086
# Needs read and write permission for the bucket. The collector reads once
# at the start, to find where the other data in the bucket begins.
INFLUX_TOKEN=my-token
INFLUX_ORG=my-org
INFLUX_BUCKET=my-bucket

# Only used by compose.yml to set up the InfluxDB container
INFLUX_USERNAME=my-user
INFLUX_PASSWORD=my-password

##### Bidding zone

# Only needed when ENABLE_PUBLIC_GRID is true, and only for a country
# with more than one bidding zone: DK1 or DK2, NO1 to NO5, SE1 to SE4,
# or a zone of Italy. For every other country, the collector finds the
# zone of the day-ahead price from COUNTRY.
# BIDDING_ZONE=SE3
