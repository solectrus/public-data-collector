##### General

# Country code, for example DE, AT or NL. The renewable share, the gas price
# and the fuel prices use it.
COUNTRY=DE

# Seconds between two cycles, minimum 60. This governs the electricity
# values. The gas price and the fuel prices are read on Friday and at every
# start.
INTERVAL=3600

# Timezone
TZ=Europe/Berlin

##### InfluxDB

INFLUX_HOST=localhost
INFLUX_SCHEMA=http
INFLUX_PORT=8086
# Needs read and write permission for the bucket. The collector reads once
# at the start, to find where the other data in the bucket begins.
INFLUX_TOKEN=my-token
INFLUX_ORG=my-org
INFLUX_BUCKET=my-bucket

# Only used by compose.yml to set up the InfluxDB container
INFLUX_USERNAME=my-user
INFLUX_PASSWORD=my-password

##### Public grid: day-ahead electricity price and renewable share

# Bidding zone of the day-ahead price
PUBLIC_GRID_BIDDING_ZONE=DE-LU

# Both values go to one measurement, in two fields that must differ
PUBLIC_GRID_MEASUREMENT=PublicGrid
PUBLIC_GRID_FIELD_PRICE=price
PUBLIC_GRID_FIELD_RENEWABLE_SHARE=renewable_share

##### Natural gas: price per kWh

GAS_MEASUREMENT=Gas

##### Fuel: price per litre of petrol, diesel, heating oil and LPG

FUEL_MEASUREMENT=Fuel
